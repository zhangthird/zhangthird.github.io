---
import T from './T.astro';

interface Props { issue?: number }
const { issue } = Astro.props;
const issueUrl = issue ? `https://github.com/zhangthird/zhangthird.github.io/issues/${issue}` : undefined;
---

<section class="comments" data-giscus-comments data-pagefind-ignore aria-labelledby="comments-title">
  <div class="comments-heading">
    <div>
      <h2 id="comments-title"><T k="comments.title" /></h2>
      <p><T k="comments.help" /></p>
    </div>
    {issueUrl && <a class="comments-history" href={issueUrl} target="_blank" rel="noreferrer"><T k="comments.history" /> <span aria-hidden="true">↗</span></a>}
  </div>
  <div class="giscus"></div>
  <script
    src="https://giscus.app/client.js"
    data-repo="zhangthird/zhangthird.github.io"
    data-repo-id="R_kgDOG6FPlA"
    data-category="General"
    data-category-id="DIC_kwDOG6FPlM4DErHy"
    data-mapping="pathname"
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async
    is:inline
    data-astro-rerun
  ></script>
</section>

<script>
  const setupGiscusSync = () => {
    const runtime = window as Window & { __giscusCleanup?: () => void };
    runtime.__giscusCleanup?.();

    const section = document.querySelector<HTMLElement>('[data-giscus-comments]');
    if (!section) return;

    const sync = () => {
      const frame = section.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage({
        giscus: {
          setConfig: {
            theme: document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light',
            lang: document.documentElement.lang.startsWith('zh') ? 'zh-CN' : 'en',
          },
        },
      }, 'https://giscus.app');
    };

    const bindFrame = () => {
      const frame = section.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      if (!frame || frame.dataset.siteSyncBound) return;
      frame.dataset.siteSyncBound = 'true';
      frame.addEventListener('load', sync);
      sync();
    };

    const rootObserver = new MutationObserver(sync);
    rootObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'lang'] });
    const frameObserver = new MutationObserver(bindFrame);
    frameObserver.observe(section, { childList: true, subtree: true });
    document.addEventListener('site:language-change', sync);
    bindFrame();

    runtime.__giscusCleanup = () => {
      rootObserver.disconnect();
      frameObserver.disconnect();
      document.removeEventListener('site:language-change', sync);
    };
  };

  setupGiscusSync();
  document.addEventListener('astro:page-load', setupGiscusSync);
</script>
