---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';
import { tagHref } from '../lib/tags';

interface Props {
  posts: CollectionEntry<'research'>[];
}
const { posts } = Astro.props;
---

<div class="post-list">
  {posts.map((post) => (
    <article class="post-row">
      <div class="post-row-layout">
        <time data-site-i18n-date datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <div class="post-row-main">
          <a href={`/${post.collection}/${post.id}/`} class="post-row-link">
            <h3 lang="en">{post.data.title}</h3>
            <p lang="en">{post.data.description}</p>
          </a>
          <div class="tag-row">
            {post.data.tags.slice(0, 3).map((tag) => <a href={tagHref(tag)}>{tag}</a>)}
          </div>
        </div>
        <span class="row-arrow" aria-hidden="true">↗</span>
      </div>
    </article>
  ))}
</div>
