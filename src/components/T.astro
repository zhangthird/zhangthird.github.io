---
import { translate } from '../lib/i18n.mjs';
interface Props { k: string; params?: Record<string, string | number> }
const { k, params = {} } = Astro.props;
---
<span translate="no" data-site-i18n={k} data-site-i18n-params={Object.keys(params).length ? JSON.stringify(params) : undefined}>{translate(k, 'en', params)}</span>
