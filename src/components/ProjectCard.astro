---
interface Props {
  index: string;
  title: string;
  description: string;
  meta: string;
  href?: string;
}
const { index, title, description, meta, href } = Astro.props;
---

<article class="project-card">
  <div class="project-index">{index}</div>
  <div class="project-content">
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="project-meta">{meta}</span>
  </div>
  {href && <a class="project-link" href={href} aria-label={`Open ${title}`}>↗</a>}
</article>
