---
import BaseLayout from '../layouts/BaseLayout.astro';
import { legacyPosts } from '../lib/legacy';
import { getCollection } from 'astro:content';
import T from '../components/T.astro';
import { translate } from '../lib/i18n.mjs';
const posts=(await getCollection('research')).filter(p=>!p.data.draft);
const entries=[...posts.map(p=>({title:p.data.title,description:p.data.description,text:`${p.data.title} ${p.data.description} ${p.body}`,url:`/${p.collection}/${p.id}/`})),...legacyPosts.map(p=>({title:p.title,description:p.description,text:`${p.title} ${p.text}`,url:p.url}))];
---
<BaseLayout titleKey="meta.search.title" descriptionKey="meta.search.description">
  <section class="page-intro page-width narrow-intro">
    <h1><T k="search.title" /></h1>
    <label class="standalone-search"><T k="search.keywords" /><input type="search" id="archive-search" placeholder={translate('search.placeholder')} data-i18n-placeholder="search.placeholder" /></label>
    <p id="search-count" role="status" aria-live="polite" data-i18n="article.count" data-i18n-params={JSON.stringify({count:entries.length})}>{translate('article.count','en',{count:entries.length})}</p>
  </section>
  <section class="page-width listing-section"><div class="post-list">{entries.map(e=><article class="post-row searchable-row" data-text={e.text.toLowerCase()}><a href={e.url} class="post-row-link"><span class="mini-label"><T k="search.note" /></span><div class="post-row-main"><h3>{e.title}</h3><p>{e.description}</p></div><span aria-hidden="true">↗</span></a></article>)}</div><p id="no-results" hidden><T k="search.none" /></p></section>
</BaseLayout>
<script>
  import { setMessage } from '../lib/i18n.mjs';
  function bindSearch(){
    const input=document.querySelector<HTMLInputElement>('#archive-search');
    if(!input||input.dataset.bound)return; input.dataset.bound='true';
    const rows=[...document.querySelectorAll<HTMLElement>('.searchable-row')];
    input.value=new URLSearchParams(location.search).get('q')||'';
    const filter=()=>{let count=0;for(const row of rows){row.hidden=!row.dataset.text?.includes(input.value.trim().toLowerCase());if(!row.hidden)count++;}setMessage(document.querySelector('#search-count'),'article.count',{count});document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;};
    input.addEventListener('input',filter);filter();
  }
  bindSearch();document.addEventListener('astro:page-load',bindSearch);
</script>
