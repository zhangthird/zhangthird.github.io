---
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---
<BaseLayout titleKey="meta.projects.title" descriptionKey="meta.projects.description" breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Projects', href: '/projects/' }]}>
  <section class="page-intro page-width narrow-intro">
    <h1><T k="nav.projects" /></h1>
    <p><T k="projects.intro" /></p>
  </section>
  <section class="project-page page-width">
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}</div>
  </section>
</BaseLayout>

