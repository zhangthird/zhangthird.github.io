---
import T from '../../components/T.astro';
import { translate } from '../../lib/i18n.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { legacyPosts } from '../../lib/legacy';
import { legacyCommentIssues } from '../../data/comments';
export function getStaticPaths() { return legacyPosts.map(post=>({params:{slug:post.slug},props:{post}})); }
interface Props { post: (typeof legacyPosts)[number] }
const { post } = Astro.props;
---
<BaseLayout title={`${post.title} — Cheng Cui`} description={post.description} image={null} type="article">
  <article class="article-wrap page-width">
    <header class="article-header"><a class="back-link" href="/essays/">← <T k="nav.essays" /></a><h1 lang="zh-CN" data-pagefind-meta="title">{post.title}</h1><div class="article-meta"><time datetime={post.date}>{post.date}</time><T k="article.legacy" /><T k="article.readingTime" params={{count:post.minutes}} /></div></header>
    {post.slug==='about' && <p class="legacy-notice"><T k="article.written" params={{date:post.date}} /> <a href="/about/"><T k="nav.about" /> →</a></p>}
    <div class="article-grid"><div class="prose" lang="zh-CN" set:html={post.body} />{post.headings.length>0 && <aside class="toc" aria-label={translate("contents")} data-site-i18n-aria-label="contents" data-pagefind-ignore><div class="toc-label"><T k="contents" /></div><nav>{post.headings.map(h=><a class:list={{nested:h.depth===3}} href={`#${h.id}`}>{h.text}</a>)}</nav></aside>}</div>
    {legacyCommentIssues[post.slug] && <Comments issue={legacyCommentIssues[post.slug]} />}
  </article>
</BaseLayout>

