---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import T from '../../../components/T.astro';
import { collectTags } from '../../../lib/tags';

const posts = (await getCollection('research')).filter((post) => !post.data.draft);
const tags = collectTags(posts);
---

<BaseLayout
  title="Research Topics — Cheng Cui"
  description="Browse Cheng Cui's research notes by topic."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Research & Engineering', href: '/research/' },
    { name: 'Topics', href: '/research/topics/' },
  ]}
>
  <section class="page-intro page-width narrow-intro">
    <a class="back-link" href="/research/">← <T k="nav.research" /></a>
    <h1><T k="tags.title" /></h1>
    <p><T k="tags.intro" /></p>
  </section>
  <section class="tag-directory page-width" aria-label="Research topics">
    {tags.map((tag) => (
      <a class="tag-directory-link" href={`/research/topics/${tag.slug}/`}>
        <strong>{tag.name}</strong>
        <T k="tags.count" params={{ count: tag.count }} />
      </a>
    ))}
  </section>
</BaseLayout>

