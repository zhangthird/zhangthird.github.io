---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import T from '../../components/T.astro';
import { translate } from '../../lib/i18n.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const posts = (await getCollection('research')).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'research'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout
  title={`${post.data.title} — Cheng Cui`}
  description={post.data.description}
  type="article"
  image={null}
>
  <article class="article-wrap page-width">
    <header class="article-header">
      <a class="back-link" href="/research/">← <T k="nav.research" /></a>
      <h1 lang="en" data-pagefind-meta="title">{post.data.title}</h1>
      <p lang="en" class="article-deck">{post.data.description}</p>
      <div class="article-meta">
        <time data-site-i18n-date datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.readingTime && <T k="article.readingTime" params={{count:parseInt(post.data.readingTime)}} />}
        {post.data.tags.map((tag) => <span class="article-tag">{tag}</span>)}
      </div>
    </header>

    <div class="article-grid">
      <div class="prose" lang="en">
        <Content />
      </div>

      {toc.length > 0 && (
        <aside class="toc" aria-label={translate("contents")} data-site-i18n-aria-label="contents" data-pagefind-ignore>
          <div class="toc-label"><T k="contents" /></div>
          <nav>
            {toc.map((heading) => (
              <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
