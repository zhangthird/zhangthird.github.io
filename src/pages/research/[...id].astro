---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import T from '../../components/T.astro';
import { translate } from '../../lib/i18n.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';
import { SITE } from '../../lib/site';
import { tagHref } from '../../lib/tags';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import InteractiveDemo from '../../components/InteractiveDemo.astro';
import Comments from '../../components/Comments.astro';
import { researchCommentIssues } from '../../data/comments';

export async function getStaticPaths() {
  const posts = (await getCollection('research')).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'research'>;
}

const { post } = Astro.props;
const publishedPosts = (await getCollection('research'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const postIndex = publishedPosts.findIndex((entry) => entry.id === post.id);
const newerPost = postIndex > 0 ? publishedPosts[postIndex - 1] : undefined;
const olderPost = postIndex >= 0 ? publishedPosts[postIndex + 1] : undefined;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const canonical = new URL(`/research/${post.id}/`, Astro.site ?? Astro.url.origin).toString();
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: SITE.name,
    url: Astro.site?.toString() ?? 'https://zhangthird.github.io/',
  },
  mainEntityOfPage: canonical,
  url: canonical,
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title={`${post.data.title} — Cheng Cui`}
  description={post.data.description}
  type="article"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Research & Engineering', href: '/research/' },
    { name: post.data.title, href: `/research/${post.id}/` },
  ]}
>
  <script type="application/ld+json" set:html={jsonLd}></script>
  <div class="reading-progress" data-reading-progress aria-hidden="true"><span></span></div>

  <article class="article-wrap page-width" data-article-root>
    <header class="article-header">
      <a class="back-link" href="/research/">← <T k="nav.research" /></a>
      <h1 lang="en" data-pagefind-meta="title">{post.data.title}</h1>
      <p lang="en" class="article-deck">{post.data.description}</p>
      <div class="article-meta">
        <time data-site-i18n-date datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.readingTime && <T k="article.readingTime" params={{count:parseInt(post.data.readingTime)}} />}
        {post.data.tags.map((tag) => <a class="article-tag" href={tagHref(tag)}>{tag}</a>)}
      </div>
    </header>

    <div class="article-grid">
      <div class="prose" lang="en" data-article-prose>
        <Content />
        {post.data.demo === 'agent-loop' && (
          <>
            <ArchitectureDiagram />
            <InteractiveDemo />
          </>
        )}
      </div>

      {toc.length > 0 && (
        <aside class="toc" aria-label={translate("contents")} data-site-i18n-aria-label="contents" data-pagefind-ignore>
          <div class="toc-label"><T k="contents" /></div>
          <nav>
            {toc.map((heading) => (
              <a class:list={{ nested: heading.depth === 3 }} data-toc-link href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
    </div>

    {(newerPost || olderPost) && (
      <nav class="article-pagination" aria-label="Research note navigation">
        {newerPost ? <a href={`/research/${newerPost.id}/`}><span><T k="article.newer" /></span><strong>{newerPost.data.title}</strong></a> : <span />}
        {olderPost ? <a href={`/research/${olderPost.id}/`}><span><T k="article.older" /></span><strong>{olderPost.data.title}</strong></a> : <span />}
      </nav>
    )}
    {researchCommentIssues[post.id] && <Comments issue={researchCommentIssues[post.id]} />}
  </article>

  <style>
    .reading-progress {
      position: fixed;
      inset: 0 0 auto;
      z-index: 40;
      height: 2px;
      pointer-events: none;
      background: transparent;
    }
    .reading-progress span {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--accent);
      transform: scaleX(var(--reading-progress, 0));
      transform-origin: left center;
      transition: transform 80ms linear;
    }
    .toc a[aria-current="location"] {
      color: var(--text);
      font-weight: var(--weight-medium);
    }
    @media (prefers-reduced-motion: reduce) {
      .reading-progress span { transition: none; }
    }
  </style>

  <script>
    function setupArticleReadingUX() {
      const runtime = window as Window & { __articleUxCleanup?: () => void };
      runtime.__articleUxCleanup?.();

      const article = document.querySelector<HTMLElement>('[data-article-root]');
      const prose = document.querySelector<HTMLElement>('[data-article-prose]');
      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      if (!article || !prose || !progress) return;

      const progressBar = progress.firstElementChild as HTMLElement | null;
      const updateProgress = () => {
        const rect = prose.getBoundingClientRect();
        const start = window.scrollY + rect.top;
        const end = start + prose.offsetHeight - window.innerHeight;
        const range = Math.max(1, end - start);
        const value = Math.min(1, Math.max(0, (window.scrollY - start) / range));
        progressBar?.style.setProperty('--reading-progress', String(value));
      };

      const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
      const headings = tocLinks
        .map((link) => {
          const id = decodeURIComponent(link.hash.slice(1));
          return { link, heading: document.getElementById(id) };
        })
        .filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => Boolean(item.heading));

      let activeId = '';
      const setActive = (id: string) => {
        if (!id || id === activeId) return;
        activeId = id;
        for (const { link, heading } of headings) {
          if (heading.id === id) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      };

      const updateActiveHeading = () => {
        let current = headings[0]?.heading.id ?? '';
        const threshold = Math.min(180, window.innerHeight * 0.25);
        for (const { heading } of headings) {
          if (heading.getBoundingClientRect().top <= threshold) current = heading.id;
          else break;
        }
        setActive(current);
      };

      const update = () => {
        updateProgress();
        updateActiveHeading();
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();

      runtime.__articleUxCleanup = () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      };
    }

    setupArticleReadingUX();
    document.addEventListener('astro:page-load', setupArticleReadingUX);
  </script>
</BaseLayout>

